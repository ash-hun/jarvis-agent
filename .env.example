# ──────────────────────────────────────────────
# Jarvis Settings  (copy to .env and fill in)
# Env prefix: JARVIS_   |  nested delimiter: __
# ──────────────────────────────────────────────

# LLM Provider
JARVIS_LLM__PROVIDER=anthropic          # anthropic | openai | google | ollama | vllm
JARVIS_LLM__MODEL=claude-sonnet-4-5
JARVIS_LLM__API_KEY=                    # leave blank for local models
JARVIS_LLM__BASE_URL=                   # Ollama: http://localhost:11434  |  vLLM: http://localhost:8000
JARVIS_LLM__TEMPERATURE=0.7
JARVIS_LLM__MAX_TOKENS=4096

# Security
JARVIS_SECURITY__REQUIRE_AUTH=true
JARVIS_SECURITY__ALLOWED_ROLES=["user","admin"]
JARVIS_SECURITY__INPUT_MAX_LENGTH=10000

# Memory
JARVIS_MEMORY__BACKEND=sqlite           # in_memory | sqlite | external
JARVIS_MEMORY__SQLITE_PATH=~/.jarvis/memory.db
JARVIS_MEMORY__WINDOW_SIZE=50
JARVIS_MEMORY__COMPACTION_THRESHOLD=100000

# Session
JARVIS_SESSION__PERSISTENCE_BACKEND=jsonl   # jsonl | postgres  (Docker: overridden to postgres automatically)
JARVIS_SESSION__SESSIONS_DIR=~/.jarvis/sessions
# Postgres DSN — 외부 DB를 사용할 때만 설정. 비워두면 Docker Compose 내부 postgres를 사용.
# JARVIS_SESSION__POSTGRES_DSN=postgresql://user:password@host:5432/jarvis

# UI
JARVIS_UI__MODE=tui                     # tui | web
JARVIS_UI__THEME=dark

# Plugins / Tools / Skills
JARVIS_PLUGIN__PLUGINS_DIR=~/.jarvis/plugins
JARVIS_PLUGIN__SKILLS_DIR=./skills          # project built-in skills (or ~/.jarvis/skills for personal)
JARVIS_PLUGIN__TOOLS_DIR=~/.jarvis/tools
JARVIS_PLUGIN__WATCH_FILES=true

# Misc
JARVIS_DEBUG=false
JARVIS_LOG_LEVEL=INFO
