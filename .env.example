# ──────────────────────────────────────────────
# Jarvis Settings  (copy to .env and fill in)
# Env prefix: JARVIS_   |  nested delimiter: __
# ──────────────────────────────────────────────

# LLM Provider
JARVIS_LLM__PROVIDER=anthropic          # anthropic | openai | google | ollama | vllm
JARVIS_LLM__MODEL=claude-sonnet-4-5
JARVIS_LLM__API_KEY=                    # leave blank for local models
JARVIS_LLM__BASE_URL=                   # Ollama: http://localhost:11434  |  vLLM: http://localhost:8000
JARVIS_LLM__TEMPERATURE=0.7
JARVIS_LLM__MAX_TOKENS=4096

# Inner Thought / Proactive — 기본 ON. 사고 모델을 메인과 분리하면 성찰이 메인 응답을 막지 않는다
# JARVIS_THOUGHT__ENABLED=true
# JARVIS_THOUGHT__MODEL=gemma4:e2b-it-qat       # 비우면 메인 모델. 로컬 Ollama 는 이 값으로 고정(0.8b 급은 JSON 을 못 지킨다)
# JARVIS_THOUGHT__PROVIDER=                     # 비우면 메인 provider 상속 (api_key, base_url 도 같음)
# JARVIS_THOUGHT__REQUEST_TIMING=after          # before | race | after. 사고와 메인이 같은 GPU 면 after(응답 뒤 사고)
# JARVIS_THOUGHT__WAIT_SEC=3.0                  # race 에서 사고를 기다리는 상한
# JARVIS_PROACTIVE__DAEMON_ENABLED=true
# JARVIS_PROACTIVE__DAEMON_INTERVAL_SEC=120     # 로컬과 배포 모두 같은 값
# 호스트 Ollama 가 성찰과 사용자 요청을 동시에 받게 하려면 (brew): launchctl setenv OLLAMA_NUM_PARALLEL 2 && brew services restart ollama

# Security
JARVIS_SECURITY__REQUIRE_AUTH=true
# Web HUD 접근 키. 비워두면 web 인증 없음(로컬 단독). 키가 곧 식별자라 길고 무작위여야 한다. TUI는 영향 없음.
# JARVIS_SECURITY__API_KEYS='{"replace-with-a-long-random-key": {"name": "jh", "roles": ["admin"]}}'
JARVIS_SECURITY__ALLOWED_ROLES=["user","admin"]
JARVIS_SECURITY__INPUT_MAX_LENGTH=10000
# JARVIS_SECURITY__APPROVALS_PATH=~/.jarvis/approvals.yaml   # 승인 화면에서 "항상 허용"한 (도구, 패턴) 규칙

# Procedures (절차 학습) — 도구를 여러 번 써서 성공한 작업을 세션 종료 때 초안으로 남긴다. /procedures approve 로 도구화
# JARVIS_PROCEDURES__ENABLED=true
# JARVIS_PROCEDURES__DIR=~/.jarvis/procedures
# JARVIS_PROCEDURES__MIN_TOOL_CALLS=3

# Notify (외부 알림) — 열린 화면이 없어도 스케줄 결과와 proactive 발화를 슬랙으로
# JARVIS_NOTIFY__SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# JARVIS_NOTIFY__KINDS=["reminder","proactive"]

# Memory
JARVIS_MEMORY__BACKEND=postgres         # in_memory | postgres
JARVIS_MEMORY__WINDOW_SIZE=50
JARVIS_MEMORY__COMPACTION_THRESHOLD=100000
# JARVIS_MEMORY__CONSOLIDATE_ON_IDLE=true   # 조용할 때(daemon idle 틱) 요약에서 사실 추출. daemon_trigger 가 interval 이면 안 돈다
# 의미 유사도 검색과 약속 중복 판정 (비우면 글자와 키워드로만). Postgres 는 pgvector 확장 필요 (compose 이미지는 포함)
# JARVIS_MEMORY__EMBEDDING_PROVIDER=ollama  # openai | ollama | vllm
# JARVIS_MEMORY__EMBEDDING_MODEL=bge-m3     # 한국어는 bge-m3. nomic-embed-text 는 다른 약속끼리도 0.9 가 넘는다
# JARVIS_MEMORY__EMBEDDING_DIMENSIONS=1024  # vllm 은 필수
# JARVIS_MEMORY__EMBEDDING_API_KEY=         # 비우면 LLM API 키
# JARVIS_MEMORY__EMBEDDING_BASE_URL=        # 비우면 provider 기본값
# JARVIS_MEMORY__POSTGRES_DSN=          # 비워두면 JARVIS_SESSION__POSTGRES_DSN 사용

# Session
JARVIS_SESSION__PERSISTENCE_BACKEND=postgres   # jsonl | postgres
JARVIS_SESSION__SESSIONS_DIR=~/.jarvis/sessions
# JARVIS_SESSION__POSTGRES_DSN=postgresql://user:password@host:5432/jarvis

# UI
JARVIS_UI__MODE=tui                     # tui | web
JARVIS_UI__THEME=dark

# Brand — 에이전트 정체성 (Web HUD 워드마크·명언·색감). 에이전트마다 다르게 둔다.
# JARVIS_BRAND__NAME=J.A.R.V.I.S.
# JARVIS_BRAND__QUOTE=Proof the Heart
# JARVIS_BRAND__PALETTE__PRIMARY=#5fc8e2          # 링·선·강조 주색 (#rrggbb)
# JARVIS_BRAND__PALETTE__ACCENT=#f0b35f           # 인디케이터·경고 보조색
# JARVIS_BRAND__PALETTE__BACKGROUND=#02060c       # 화면 바탕
# JARVIS_BRAND__PALETTE__NEBULA=["#3a5bff","#8a4dff","#ff6ad5"]  # 리액터 코어 성운 색 (안쪽→바깥)

# Plugins / Tools / Skills
JARVIS_PLUGIN__PLUGINS_DIR=~/.jarvis/plugins
JARVIS_PLUGIN__SKILLS_DIR=./skills          # project built-in skills (or ~/.jarvis/skills for personal)
JARVIS_PLUGIN__TOOLS_DIR=~/.jarvis/tools
JARVIS_PLUGIN__WATCH_FILES=true
# JARVIS_AGENTS__SUPERVISOR_PROMPT=~/.jarvis/supervisor.md   # supervisor 패턴 감독자 지시문(문자열 또는 파일 경로)
# JARVIS_TEAM__DIR=~/.jarvis/team   # JARVIS 와 같은 층의 최상위 에이전트 정의(파일 이름이 id). docker 는 저장소 team/ 을 쓴다

# Timezone — 스케줄(cron)·/schedule 마감 시각을 해석하는 기준 (docker compose 기본값 Asia/Seoul)
# TZ=Asia/Seoul

# Voice — 영어 문장만 Piper 음성 모델로 서버에서 읽는다. 한국어는 TTS_PROVIDER(browser 면 브라우저)가 읽는다.
# 모델은 ~/.jarvis/voices/ 에 .onnx 와 .onnx.json 을 같이 둔다. 받는 법은 문서의 Voice Interface 페이지에 있다.
# JARVIS_VOICE__TTS_PROVIDER=browser
# JARVIS_VOICE__ENGLISH_TTS_PROVIDER=piper
# JARVIS_VOICE__PIPER_MODEL=~/.jarvis/voices/en-voice.onnx

# Misc
JARVIS_DEBUG=false
JARVIS_LOG_LEVEL=INFO
